//@version=5
indicator("KAIROS SMC — Lux Parity Base", "KAIROS SMC", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// Base estrutural portada da matemática LuxAlgo fornecida pelo utilizador.
// Camada 1: estrutura Swing 50 + Internal 5, PDH/PDL/PWH/PWL/PMH/PML,
// EQH/EQL ATR200, Premium/Discount e painel MN->M5.
// Regras causais Kairos serão adicionadas somente sobre esta base validável.

BULLISH_LEG = 1
BEARISH_LEG = 0
BULLISH = 1
BEARISH = -1

swingLen = input.int(50, "Swing length", minval=10)
internalLen = input.int(5, "Internal length", minval=1)
eqLen = input.int(3, "EQH/EQL confirmation", minval=1)
eqThreshold = input.float(0.1, "EQH/EQL threshold × ATR200", minval=0, maxval=0.5, step=0.1)
showSwing = input.bool(true, "Swing BOS/CHoCH")
showInternal = input.bool(true, "Internal BOS/CHoCH")
showRefs = input.bool(true, "Previous D/W/M High/Low")
showPD = input.bool(true, "Premium/Discount")
showPanel = input.bool(true, "MTF panel")
showOB = input.bool(true, "Lux-style Order Blocks")
showFVG = input.bool(true, "Lux-style FVG")
obMitigationClose = input.bool(false, "OB mitigation by Close")

type Pivot
    float current
    float last
    bool crossed
    int t
    int idx

type Trend
    int bias

type OrderBlock
    float hi
    float lo
    int t
    int bias
    box bx

type Fvg
    float top
    float bottom
    int bias
    box bx

var Pivot swingHigh = Pivot.new(na,na,false,time,bar_index)
var Pivot swingLow = Pivot.new(na,na,false,time,bar_index)
var Pivot internalHigh = Pivot.new(na,na,false,time,bar_index)
var Pivot internalLow = Pivot.new(na,na,false,time,bar_index)
var Trend swingTrend = Trend.new(0)
var Trend internalTrend = Trend.new(0)
var array<float> parsedHighs = array.new_float()
var array<float> parsedLows = array.new_float()
var array<int> barTimes = array.new_int()
var array<OrderBlock> obs = array.new<OrderBlock>()
var array<Fvg> fvgs = array.new<Fvg>()
atr200 = ta.atr(200)
volatilityMeasure = atr200
highVolatilityBar = (high-low) >= 2*volatilityMeasure
parsedHighs.push(highVolatilityBar ? low : high)
parsedLows.push(highVolatilityBar ? high : low)
barTimes.push(time)

leg(int size) =>
    var int l = 0
    newHigh = high[size] > ta.highest(size)
    newLow = low[size] < ta.lowest(size)
    if newHigh
        l := BEARISH_LEG
    else if newLow
        l := BULLISH_LEG
    l

updatePivots(int size, bool internal) =>
    l = leg(size)
    newPivot = ta.change(l) != 0
    pivotLow = ta.change(l) == 1
    if newPivot
        if pivotLow
            Pivot p = internal ? internalLow : swingLow
            p.last := p.current
            p.current := low[size]
            p.crossed := false
            p.t := time[size]
            p.idx := bar_index[size]
        else
            Pivot p = internal ? internalHigh : swingHigh
            p.last := p.current
            p.current := high[size]
            p.crossed := false
            p.t := time[size]
            p.idx := bar_index[size]

storeOB(Pivot p, int bias) =>
    if showOB and p.idx >= 0 and p.idx < bar_index
        int from = p.idx
        int to = bar_index
        array<float> a = bias == BEARISH ? parsedHighs.slice(from,to) : parsedLows.slice(from,to)
        if a.size() > 0
            int rel = bias == BEARISH ? a.indexof(a.max()) : a.indexof(a.min())
            int ix = from + rel
            float bh = parsedHighs.get(ix)
            float bl = parsedLows.get(ix)
            box b = box.new(barTimes.get(ix),bh,time,bl,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(bias==BULLISH?color.blue:color.red,85),border_color=color.new(color.gray,70))
            obs.unshift(OrderBlock.new(bh,bl,barTimes.get(ix),bias,b))
            if obs.size()>30
                OrderBlock old=obs.pop()
                old.bx.delete()

drawBreak(Pivot p, string tag, bool bull, bool internal) =>
    line.new(p.t,p.current,time,p.current,xloc=xloc.bar_time,style=internal?line.style_dashed:line.style_solid)
    label.new(bar_index,p.current,tag,style=bull?label.style_label_down:label.style_label_up,size=internal?size.tiny:size.small)

displayStructure(bool internal) =>
    Pivot hi = internal ? internalHigh : swingHigh
    Pivot lo = internal ? internalLow : swingLow
    Trend tr = internal ? internalTrend : swingTrend
    bullExtra = internal ? internalHigh.current != swingHigh.current : true
    bearExtra = internal ? internalLow.current != swingLow.current : true
    if ta.crossover(close,hi.current) and not hi.crossed and bullExtra
        tag = tr.bias == BEARISH ? "CHoCH" : "BOS"
        hi.crossed := true
        tr.bias := BULLISH
        if (internal and showInternal) or (not internal and showSwing)
            drawBreak(hi,tag,true,internal)
        storeOB(hi,BULLISH)
    if ta.crossunder(close,lo.current) and not lo.crossed and bearExtra
        tag = tr.bias == BULLISH ? "CHoCH" : "BOS"
        lo.crossed := true
        tr.bias := BEARISH
        if (internal and showInternal) or (not internal and showSwing)
            drawBreak(lo,tag,false,internal)
        storeOB(lo,BEARISH)

updatePivots(swingLen,false)
updatePivots(internalLen,true)
displayStructure(true)
displayStructure(false)

// Lux OB mitigation lifecycle
if obs.size()>0
    for i=obs.size()-1 to 0
        OrderBlock ob=obs.get(i)
        bearSrc=obMitigationClose?close:high
        bullSrc=obMitigationClose?close:low
        crossed=(ob.bias==BEARISH and bearSrc>ob.hi) or (ob.bias==BULLISH and bullSrc<ob.lo)
        if crossed
            ob.bx.delete()
            obs.remove(i)

// Lux FVG formula from the supplied source, evaluated on chart timeframe.
barDeltaPercent=(close[1]-open[1])/(open[1]*100)
threshold=ta.cum(math.abs(barDeltaPercent))/math.max(bar_index,1)*2
newBullFvg=showFVG and low>high[2] and close[1]>high[2] and barDeltaPercent>threshold
newBearFvg=showFVG and high<low[2] and close[1]<low[2] and -barDeltaPercent>threshold
if newBullFvg
    box b=box.new(time[1],low,time,high[2],xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(color.green,82),border_color=color.new(color.green,60))
    fvgs.unshift(Fvg.new(low,high[2],BULLISH,b))
if newBearFvg
    box b=box.new(time[1],low[2],time,high,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(color.red,82),border_color=color.new(color.red,60))
    fvgs.unshift(Fvg.new(high,low[2],BEARISH,b))
if fvgs.size()>0
    for i=fvgs.size()-1 to 0
        Fvg g=fvgs.get(i)
        invalid=(g.bias==BULLISH and low<g.bottom) or (g.bias==BEARISH and high>g.top)
        if invalid
            g.bx.delete()
            fvgs.remove(i)

// Previous CLOSED period references
pdh = request.security(syminfo.tickerid,"D",high[1],lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid,"D",low[1],lookahead=barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid,"W",high[1],lookahead=barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid,"W",low[1],lookahead=barmerge.lookahead_on)
pmh = request.security(syminfo.tickerid,"M",high[1],lookahead=barmerge.lookahead_on)
pml = request.security(syminfo.tickerid,"M",low[1],lookahead=barmerge.lookahead_on)
plot(showRefs?pdh:na,"PDH")
plot(showRefs?pdl:na,"PDL")
plot(showRefs?pwh:na,"PWH")
plot(showRefs?pwl:na,"PWL")
plot(showRefs?pmh:na,"PMH")
plot(showRefs?pml:na,"PML")

// Lux EQH/EQL formula: abs(levelA-levelB) < threshold * ATR(200)
eqLeg = leg(eqLen)
eqNew = ta.change(eqLeg) != 0
var float prevEqHigh = na
var float prevEqLow = na
if eqNew
    if ta.change(eqLeg) == -1
        h = high[eqLen]
        if not na(prevEqHigh) and math.abs(prevEqHigh-h) < eqThreshold*atr200
            label.new(bar_index-eqLen,h,"EQH",style=label.style_label_down,size=size.tiny)
        prevEqHigh := h
    else
        l = low[eqLen]
        if not na(prevEqLow) and math.abs(prevEqLow-l) < eqThreshold*atr200
            label.new(bar_index-eqLen,l,"EQL",style=label.style_label_up,size=size.tiny)
        prevEqLow := l

// Lux trailing swing range / premium-discount geometry
var float trailTop = na
var float trailBottom = na
if not na(swingHigh.current)
    trailTop := na(trailTop) ? swingHigh.current : math.max(high,trailTop)
if not na(swingLow.current)
    trailBottom := na(trailBottom) ? swingLow.current : math.min(low,trailBottom)
eq = (trailTop+trailBottom)/2
plot(showPD?eq:na,"Equilibrium")

// Compact MTF structural state. Same structural function is evaluated independently per TF.
biasForTf() =>
    var int b = 0
    l = leg(swingLen)
    if ta.change(l) == -1
        b := BEARISH
    else if ta.change(l) == 1
        b := BULLISH
    b

mnBias = request.security(syminfo.tickerid,"M",biasForTf())
wBias  = request.security(syminfo.tickerid,"W",biasForTf())
dBias  = request.security(syminfo.tickerid,"D",biasForTf())
h4Bias = request.security(syminfo.tickerid,"240",biasForTf())
h1Bias = request.security(syminfo.tickerid,"60",biasForTf())
m15Bias= request.security(syminfo.tickerid,"15",biasForTf())
m5Bias = request.security(syminfo.tickerid,"5",biasForTf())

biasText(int b) => b==BULLISH ? "↑" : b==BEARISH ? "↓" : "—"
var table panel = table.new(position.top_right,2,8)
if barstate.islast and showPanel
    table.cell(panel,0,0,"KAIROS")
    table.cell(panel,1,0,"ESTRUTURA")
    table.cell(panel,0,1,"MN"), table.cell(panel,1,1,biasText(mnBias))
    table.cell(panel,0,2,"W1"), table.cell(panel,1,2,biasText(wBias))
    table.cell(panel,0,3,"D1"), table.cell(panel,1,3,biasText(dBias))
    table.cell(panel,0,4,"H4"), table.cell(panel,1,4,biasText(h4Bias))
    table.cell(panel,0,5,"H1"), table.cell(panel,1,5,biasText(h1Bias))
    table.cell(panel,0,6,"M15"),table.cell(panel,1,6,biasText(m15Bias))
    table.cell(panel,0,7,"M5"), table.cell(panel,1,7,biasText(m5Bias))
