//@version=5
indicator("KAIROS SMC — Lux Parity Base", "KAIROS SMC", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// Base estrutural portada da matemática LuxAlgo fornecida pelo utilizador.
// Camada 1: estrutura Swing 50 + Internal 5, PDH/PDL/PWH/PWL/PMH/PML,
// EQH/EQL ATR200, Premium/Discount e painel MN->M5.
// Regras causais Kairos serão adicionadas somente sobre esta base validável.

BULLISH_LEG = 1
BEARISH_LEG = 0
BULLISH = 1
BEARISH = -1

swingLen = input.int(50, "Swing length", minval=10)
internalLen = input.int(5, "Internal length", minval=1)
eqLen = input.int(3, "EQH/EQL confirmation", minval=1)
eqThreshold = input.float(0.1, "EQH/EQL threshold × ATR200", minval=0, maxval=0.5, step=0.1)
showSwing = input.bool(true, "Swing BOS/CHoCH")
showInternal = input.bool(true, "Internal BOS/CHoCH")
showRefs = input.bool(true, "Previous D/W/M High/Low")
showPD = input.bool(true, "Premium/Discount")
showPanel = input.bool(true, "MTF panel")
showOB = input.bool(true, "Lux-style Order Blocks")
showFVG = input.bool(true, "Lux-style FVG")
obMitigationClose = input.bool(false, "OB mitigation by Close")

type Pivot
    float current
    float last
    bool crossed
    int t
    int idx

type Trend
    int bias

type OrderBlock
    float hi
    float lo
    int t
    int bias
    box bx

type Fvg
    float top
    float bottom
    int bias
    box bx

var Pivot swingHigh = Pivot.new(na,na,false,time,bar_index)
var Pivot swingLow = Pivot.new(na,na,false,time,bar_index)
var Pivot internalHigh = Pivot.new(na,na,false,time,bar_index)
var Pivot internalLow = Pivot.new(na,na,false,time,bar_index)
var Trend swingTrend = Trend.new(0)
var Trend internalTrend = Trend.new(0)
var array<float> parsedHighs = array.new_float()
var array<float> parsedLows = array.new_float()
var array<int> barTimes = array.new_int()
var array<OrderBlock> obs = array.new<OrderBlock>()
var array<Fvg> fvgs = array.new<Fvg>()
atr200 = ta.atr(200)
volatilityMeasure = atr200
highVolatilityBar = (high-low) >= 2*volatilityMeasure
parsedHighs.push(highVolatilityBar ? low : high)
parsedLows.push(highVolatilityBar ? high : low)
barTimes.push(time)

leg(int size) =>
    var int l = 0
    newHigh = high[size] > ta.highest(size)
    newLow = low[size] < ta.lowest(size)
    if newHigh
        l := BEARISH_LEG
    else if newLow
        l := BULLISH_LEG
    l

updatePivots(int size, bool internal) =>
    l = leg(size)
    newPivot = ta.change(l) != 0
    pivotLow = ta.change(l) == 1
    if newPivot
        if pivotLow
            Pivot p = internal ? internalLow : swingLow
            p.last := p.current
            p.current := low[size]
            p.crossed := false
            p.t := time[size]
            p.idx := bar_index[size]
        else
            Pivot p = internal ? internalHigh : swingHigh
            p.last := p.current
            p.current := high[size]
            p.crossed := false
            p.t := time[size]
            p.idx := bar_index[size]

storeOB(Pivot p, int bias) =>
    if showOB and p.idx >= 0 and p.idx < bar_index
        int from = p.idx
        int endIdx = bar_index
        array<float> a = bias == BEARISH ? parsedHighs.slice(from,endIdx) : parsedLows.slice(from,endIdx)
        if a.size() > 0
            int rel = bias == BEARISH ? a.indexof(a.max()) : a.indexof(a.min())
            int ix = from + rel
            float bh = parsedHighs.get(ix)
            float bl = parsedLows.get(ix)
            box b = box.new(barTimes.get(ix),bh,time,bl,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(bias==BULLISH?obBullColor:obBearColor,showOldPois?poiTransparency:100),border_color=color.new(color.gray,70))
            obs.unshift(OrderBlock.new(bh,bl,barTimes.get(ix),bias,b))
            if obs.size()>30
                OrderBlock old=obs.pop()
                old.bx.delete()

drawBreak(Pivot p, string tag, bool bull, bool internal) =>
    line.new(p.t,p.current,time,p.current,xloc=xloc.bar_time,style=internal?line.style_dashed:line.style_solid)
    label.new(bar_index,p.current,tag,style=bull?label.style_label_down:label.style_label_up,size=internal?size.tiny:size.small)

displayStructure(bool internal) =>
    Pivot hi = internal ? internalHigh : swingHigh
    Pivot lo = internal ? internalLow : swingLow
    Trend tr = internal ? internalTrend : swingTrend
    bullExtra = internal ? internalHigh.current != swingHigh.current : true
    bearExtra = internal ? internalLow.current != swingLow.current : true
    if ta.crossover(close,hi.current) and not hi.crossed and bullExtra
        tag = tr.bias == BEARISH ? "CHoCH" : "BOS"
        hi.crossed := true
        tr.bias := BULLISH
        if (internal and showInternal) or (not internal and showSwing)
            drawBreak(hi,tag,true,internal)
        storeOB(hi,BULLISH)
    if ta.crossunder(close,lo.current) and not lo.crossed and bearExtra
        tag = tr.bias == BULLISH ? "CHoCH" : "BOS"
        lo.crossed := true
        tr.bias := BEARISH
        if (internal and showInternal) or (not internal and showSwing)
            drawBreak(lo,tag,false,internal)
        storeOB(lo,BEARISH)

updatePivots(swingLen,false)
updatePivots(internalLen,true)
displayStructure(true)
displayStructure(false)

// Lux OB mitigation lifecycle
if obs.size()>0
    for i=obs.size()-1 to 0
        OrderBlock ob=obs.get(i)
        bearSrc=obMitigationClose?close:high
        bullSrc=obMitigationClose?close:low
        crossed=(ob.bias==BEARISH and bearSrc>ob.hi) or (ob.bias==BULLISH and bullSrc<ob.lo)
        if crossed
            ob.bx.delete()
            obs.remove(i)

// Lux FVG formula from the supplied source, evaluated on chart timeframe.
barDeltaPercent=(close[1]-open[1])/(open[1]*100)
threshold=ta.cum(math.abs(barDeltaPercent))/math.max(bar_index,1)*2
newBullFvg=showFVG and low>high[2] and close[1]>high[2] and barDeltaPercent>threshold
newBearFvg=showFVG and high<low[2] and close[1]<low[2] and -barDeltaPercent>threshold
if newBullFvg
    box b=box.new(time[1],low,time,high[2],xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(fvgBullColor,showOldPois?poiTransparency:100),border_color=color.new(fvgBullColor,60))
    fvgs.unshift(Fvg.new(low,high[2],BULLISH,b))
if newBearFvg
    box b=box.new(time[1],low[2],time,high,xloc=xloc.bar_time,extend=extend.right,bgcolor=color.new(fvgBearColor,showOldPois?poiTransparency:100),border_color=color.new(fvgBearColor,60))
    fvgs.unshift(Fvg.new(high,low[2],BEARISH,b))
if fvgs.size()>0
    for i=fvgs.size()-1 to 0
        Fvg g=fvgs.get(i)
        invalid=(g.bias==BULLISH and low<g.bottom) or (g.bias==BEARISH and high>g.top)
        if invalid
            g.bx.delete()
            fvgs.remove(i)

// Previous CLOSED period references
pdh = request.security(syminfo.tickerid,"D",high[1],lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid,"D",low[1],lookahead=barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid,"W",high[1],lookahead=barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid,"W",low[1],lookahead=barmerge.lookahead_on)
pmh = request.security(syminfo.tickerid,"M",high[1],lookahead=barmerge.lookahead_on)
pml = request.security(syminfo.tickerid,"M",low[1],lookahead=barmerge.lookahead_on)
plot(showRefs and showLiquidityRefs?pdh:na,"PDH",color=liqColor)
plot(showRefs and showLiquidityRefs?pdl:na,"PDL",color=liqColor)
plot(showRefs and showLiquidityRefs?pwh:na,"PWH",color=liqColor)
plot(showRefs and showLiquidityRefs?pwl:na,"PWL",color=liqColor)
plot(showRefs and showLiquidityRefs?pmh:na,"PMH",color=liqColor)
plot(showRefs and showLiquidityRefs?pml:na,"PML",color=liqColor)

// Lux EQH/EQL formula: abs(levelA-levelB) < threshold * ATR(200)
eqLeg = leg(eqLen)
eqNew = ta.change(eqLeg) != 0
var float prevEqHigh = na
var float prevEqLow = na
if eqNew
    if ta.change(eqLeg) == -1
        h = high[eqLen]
        if not na(prevEqHigh) and math.abs(prevEqHigh-h) < eqThreshold*atr200
            label.new(bar_index-eqLen,h,"EQH",style=label.style_label_down,size=size.tiny)
        prevEqHigh := h
    else
        l = low[eqLen]
        if not na(prevEqLow) and math.abs(prevEqLow-l) < eqThreshold*atr200
            label.new(bar_index-eqLen,l,"EQL",style=label.style_label_up,size=size.tiny)
        prevEqLow := l

// Lux trailing swing range / premium-discount geometry
var float trailTop = na
var float trailBottom = na
if not na(swingHigh.current)
    trailTop := na(trailTop) ? swingHigh.current : math.max(high,trailTop)
if not na(swingLow.current)
    trailBottom := na(trailBottom) ? swingLow.current : math.min(low,trailBottom)
eq = (trailTop+trailBottom)/2
plot(showPD?eq:na,"Equilibrium")

// Compact MTF structural state. Same structural function is evaluated independently per TF.
biasForTf() =>
    var int b = 0
    l = leg(swingLen)
    if ta.change(l) == -1
        b := BEARISH
    else if ta.change(l) == 1
        b := BULLISH
    b

mnBias = request.security(syminfo.tickerid,"M",biasForTf())
wBias  = request.security(syminfo.tickerid,"W",biasForTf())
dBias  = request.security(syminfo.tickerid,"D",biasForTf())
h4Bias = request.security(syminfo.tickerid,"240",biasForTf())
h1Bias = request.security(syminfo.tickerid,"60",biasForTf())
m15Bias= request.security(syminfo.tickerid,"15",biasForTf())
m5Bias = request.security(syminfo.tickerid,"5",biasForTf())

biasText(int b) =>
    string txt = "—"
    if b == BULLISH
        txt := "↑"
    else if b == BEARISH
        txt := "↓"
    txt

//-----------------------------------------------------
// KAIROS CAUSAL EXECUTION LAYER
//-----------------------------------------------------
showKairos = input.bool(true, "KAIROS causal chain")
sweepLookback = input.int(20, "Liquidity sweep lookback", minval=5)
atr14 = ta.atr(14)

// Closed previous-day equilibrium: location only, never a trigger.
prevDayEq = (pdh + pdl) / 2.0
plot(showKairos ? prevDayEq : na, "Previous D1 EQ 50%")

// Active liquidity: previous D/W/M highs/lows + latest structural pivots.
bullSweepLevel = math.max(nz(pdh, high), nz(swingHigh.current, high))
bearSweepLevel = math.min(nz(pdl, low), nz(swingLow.current, low))
sweepHigh = high > bullSweepLevel[1] and close < bullSweepLevel[1]
sweepLow  = low < bearSweepLevel[1] and close > bearSweepLevel[1]

// Reaction is neutral until reclaim/rejection is actually closed.
var int reaction = 0
var int captureTs = na
var float captureExtreme = na
if sweepHigh
    reaction := BEARISH
    captureTs := time
    captureExtreme := high
if sweepLow
    reaction := BULLISH
    captureTs := time
    captureExtreme := low

// M15 major = Swing50; internal = Internal5. Internal can only confirm after major agrees.
majorBias15 = request.security(syminfo.tickerid,"15",swingTrend.bias)
internalBias15 = request.security(syminfo.tickerid,"15",internalTrend.bias)
majorAuthorized = reaction != 0 and majorBias15 == reaction
internalAuthorized = majorAuthorized and internalBias15 == reaction

// Nearest open chart-TF causal POI in the authorized direction.
float poiTop = na
float poiBottom = na
if fvgs.size() > 0
    for j=0 to fvgs.size()-1
        Fvg z=fvgs.get(j)
        if na(poiTop) and z.bias==reaction
            poiTop:=z.top
            poiBottom:=z.bottom
if na(poiTop) and obs.size() > 0
    for j=0 to obs.size()-1
        OrderBlock z=obs.get(j)
        if na(poiTop) and z.bias==reaction
            poiTop:=z.hi
            poiBottom:=z.lo

poiReady = internalAuthorized and not na(poiTop)
retest = poiReady and high >= poiBottom and low <= poiTop

// Execution only exists after the causal chain has reached the retest.
isExecTf = timeframe.period=="15" or timeframe.period=="5"
executionAuthorized = isExecTf and reaction!=0 and majorAuthorized and internalAuthorized and poiReady and retest

float entry = na
if executionAuthorized
    if reaction == BULLISH
        entry := poiTop
    else if reaction == BEARISH
        entry := poiBottom

// Temporary structural safety rule: never expose an invalid-sided stop.
float slCandidate = na
if executionAuthorized
    if reaction == BULLISH
        slCandidate := captureExtreme - atr14*0.25
    else if reaction == BEARISH
        slCandidate := captureExtreme + atr14*0.25

float slRaw = na
if executionAuthorized and reaction == BULLISH and not na(slCandidate) and slCandidate < entry
    slRaw := slCandidate
else if executionAuthorized and reaction == BEARISH and not na(slCandidate) and slCandidate > entry
    slRaw := slCandidate

float risk = na
if not na(entry) and not na(slRaw)
    risk := math.abs(entry-slRaw)

float beTrigger = na
if reaction == BULLISH and not na(risk)
    beTrigger := entry+risk
else if reaction == BEARISH and not na(risk)
    beTrigger := entry-risk

// Nearest valid/relevant liquidity ahead. Micro-to-macro candidates; no fixed RR target.
nearestAbove(float e) =>
    float t=na
    float[] vals=array.from(swingHigh.current,pdh,pwh,pmh)
    for k=0 to array.size(vals)-1
        v=array.get(vals,k)
        if not na(v) and v>e
            t:=na(t)?v:math.min(t,v)
    t
nearestBelow(float e) =>
    float t=na
    float[] vals=array.from(swingLow.current,pdl,pwl,pml)
    for k=0 to array.size(vals)-1
        v=array.get(vals,k)
        if not na(v) and v<e
            t:=na(t)?v:math.max(t,v)
    t

float target = na
if executionAuthorized and reaction == BULLISH and not na(entry)
    target := nearestAbove(entry)
else if executionAuthorized and reaction == BEARISH and not na(entry)
    target := nearestBelow(entry)

targetSideOk = (reaction==BULLISH and not na(target) and target>entry) or (reaction==BEARISH and not na(target) and target<entry)
fullChain = showKairos and executionAuthorized and not na(entry) and not na(slRaw) and not na(target) and targetSideOk

plot(showKairos and poiReady ? poiTop : na, "KAIROS POI top", style=plot.style_linebr)
plot(showKairos and poiReady ? poiBottom : na, "KAIROS POI bottom", style=plot.style_linebr)
plot(showKairos and fullChain ? entry : na, "ENTRY", style=plot.style_linebr, linewidth=2)
plot(showKairos and fullChain ? slRaw : na, "SL", style=plot.style_linebr, linewidth=2)
plot(showKairos and fullChain ? beTrigger : na, "+1R BE", style=plot.style_linebr)
plot(showKairos and fullChain ? target : na, "TARGET LIQ", style=plot.style_linebr, linewidth=2)

plotshape(showKairos and sweepHigh, title="External BSL captured", text="BSL SWEEP", style=shape.labeldown, location=location.abovebar, size=size.tiny)
plotshape(showKairos and sweepLow, title="External SSL captured", text="SSL SWEEP", style=shape.labelup, location=location.belowbar, size=size.tiny)
plotshape(fullChain and reaction==BULLISH, title="KAIROS LONG", text="KAIROS LONG", style=shape.labelup, location=location.belowbar)
plotshape(fullChain and reaction==BEARISH, title="KAIROS SHORT", text="KAIROS SHORT", style=shape.labeldown, location=location.abovebar)

string missingLink = "EXEC TF M15/M5"
if reaction == 0
    missingLink := "LIQUIDITY CAPTURE"
else if not majorAuthorized
    missingLink := "M15 MAJOR"
else if not internalAuthorized
    missingLink := "M15 INTERNAL"
else if not poiReady
    missingLink := "CAUSAL POI"
else if not retest
    missingLink := "RETEST"
else if na(target)
    missingLink := "TARGET LIQUIDITY"
else if fullChain
    missingLink := "TRADE READY"

stateText = fullChain ? (reaction==BULLISH ? "LONG READY" : "SHORT READY") : (poiReady and not retest ? "AGUARDANDO RETESTE" : "SEM TRADE")
stateColor = fullChain ? color.new(color.green,0) : color.new(color.orange,0)
okColor = color.new(color.green,0)
waitColor = color.new(color.gray,35)
bearColor = color.new(color.red,0)
bullColor = color.new(color.green,0)
headerBg = color.new(color.black,0)
sectionBg = color.new(color.gray,85)

var table dash = table.new(position.top_right,4,13,border_width=1)

if barstate.islast and showKairos
    table.clear(dash,0,0,3,12)
    table.cell(dash,0,0,"KAIROS",text_color=color.white,bgcolor=headerBg,text_size=size.small)
    table.cell(dash,1,0,syminfo.ticker,text_color=color.white,bgcolor=headerBg)
    table.cell(dash,2,0,timeframe.period,text_color=color.white,bgcolor=headerBg)
    table.cell(dash,3,0,stateText,text_color=color.white,bgcolor=stateColor)

    table.cell(dash,0,1,"MACRO",text_color=color.white,bgcolor=sectionBg)
    table.cell(dash,1,1,"MN "+biasText(mnBias),text_color=color.white,bgcolor=sectionBg)
    table.cell(dash,2,1,"W1 "+biasText(wBias),text_color=color.white,bgcolor=sectionBg)
    table.cell(dash,3,1,"D1 "+biasText(dBias),text_color=color.white,bgcolor=sectionBg)

    table.cell(dash,0,2,"H4 "+biasText(h4Bias),text_color=color.white)
    table.cell(dash,1,2,"H1 "+biasText(h1Bias),text_color=color.white)
    table.cell(dash,2,2,"M15 "+biasText(m15Bias),text_color=color.white)
    table.cell(dash,3,2,"M5 "+biasText(m5Bias),text_color=color.white)

    table.cell(dash,0,3,"CADEIA CAUSAL",text_color=color.white,bgcolor=sectionBg)
    table.cell(dash,1,3,"",bgcolor=sectionBg)
    table.cell(dash,2,3,"",bgcolor=sectionBg)
    table.cell(dash,3,3,"",bgcolor=sectionBg)

    table.cell(dash,0,4,"Liquidez")
    table.cell(dash,1,4,reaction==0?"—":"✓",text_color=reaction==0?waitColor:okColor)
    table.cell(dash,2,4,"Reação")
    table.cell(dash,3,4,reaction==BULLISH?"BULL":reaction==BEARISH?"BEAR":"—",text_color=reaction==BULLISH?bullColor:reaction==BEARISH?bearColor:waitColor)

    table.cell(dash,0,5,"M15 Major")
    table.cell(dash,1,5,majorAuthorized?"✓":"—",text_color=majorAuthorized?okColor:waitColor)
    table.cell(dash,2,5,"M15 Internal")
    table.cell(dash,3,5,internalAuthorized?"✓":"—",text_color=internalAuthorized?okColor:waitColor)

    table.cell(dash,0,6,"POI causal")
    table.cell(dash,1,6,poiReady?"✓":"—",text_color=poiReady?okColor:waitColor)
    table.cell(dash,2,6,"Reteste")
    table.cell(dash,3,6,retest?"✓":"—",text_color=retest?okColor:waitColor)

    table.cell(dash,0,7,"EXECUÇÃO",text_color=color.white,bgcolor=sectionBg)
    table.cell(dash,1,7,"",bgcolor=sectionBg)
    table.cell(dash,2,7,"",bgcolor=sectionBg)
    table.cell(dash,3,7,"",bgcolor=sectionBg)

    table.cell(dash,0,8,"ENTRY")
    table.cell(dash,1,8,na(entry)?"—":str.tostring(entry,format.mintick))
    table.cell(dash,2,8,"SL")
    table.cell(dash,3,8,na(slRaw)?"—":str.tostring(slRaw,format.mintick))

    table.cell(dash,0,9,"+1R → BE")
    table.cell(dash,1,9,na(beTrigger)?"—":str.tostring(beTrigger,format.mintick))
    table.cell(dash,2,9,"TARGET")
    table.cell(dash,3,9,na(target)?"—":str.tostring(target,format.mintick))

    table.cell(dash,0,10,"LOCALIZAÇÃO",text_color=color.white,bgcolor=sectionBg)
    table.cell(dash,1,10,close>prevDayEq?"PREMIUM":"DISCOUNT",bgcolor=sectionBg)
    table.cell(dash,2,10,"D1 EQ",bgcolor=sectionBg)
    table.cell(dash,3,10,str.tostring(prevDayEq,format.mintick),bgcolor=sectionBg)

    table.cell(dash,0,11,"FALTA",text_color=color.white)
    table.cell(dash,1,11,missingLink,text_color=fullChain?okColor:color.orange)
    table.cell(dash,2,11,"Estado")
    table.cell(dash,3,11,stateText,text_color=stateColor)

    table.cell(dash,0,12,"SEM CADEIA = SEM TRADE",text_color=color.white,bgcolor=headerBg)
    table.cell(dash,1,12,"",bgcolor=headerBg)
    table.cell(dash,2,12,"",bgcolor=headerBg)
    table.cell(dash,3,12,"",bgcolor=headerBg)

alertcondition(fullChain and reaction==BULLISH, "KAIROS LONG READY", "KAIROS LONG: cadeia causal completa")
alertcondition(fullChain and reaction==BEARISH, "KAIROS SHORT READY", "KAIROS SHORT: cadeia causal completa")
