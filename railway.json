{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python patch_htf_structure_radar_v4.py"
  },
  "deploy": {
    "preDeployCommand": [
      "PYTHONPATH=deps python -m pytest -q --ignore=legacy-mute"
    ],
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
